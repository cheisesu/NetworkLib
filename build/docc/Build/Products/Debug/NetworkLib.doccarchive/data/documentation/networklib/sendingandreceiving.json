{"hierarchy":{"paths":[["doc:\/\/NetworkLib\/documentation\/NetworkLib"]]},"metadata":{"modules":[{"name":"NetworkLib"}],"roleHeading":"Article","role":"article","title":"Sending and Receiving Data"},"kind":"article","abstract":[{"type":"text","text":"Connect securely, send bytes, and read a response with async\/await."}],"identifier":{"url":"doc:\/\/NetworkLib\/documentation\/NetworkLib\/SendingAndReceiving","interfaceLanguage":"swift"},"sections":[],"seeAlsoSections":[{"title":"Related Documentation","anchor":"Related-Documentation","identifiers":["doc:\/\/NetworkLib\/documentation\/NetworkLib\/UsingCallbacks","doc:\/\/NetworkLib\/documentation\/NetworkLib\/UsingProxies"]},{"title":"API usage examples","anchor":"API-usage-examples","identifiers":["doc:\/\/NetworkLib\/documentation\/NetworkLib\/RunningExamples","doc:\/\/NetworkLib\/documentation\/NetworkLib\/UsingCallbacks","doc:\/\/NetworkLib\/documentation\/NetworkLib\/UsingProxies","doc:\/\/NetworkLib\/documentation\/NetworkLib\/TypedMessages","doc:\/\/NetworkLib\/documentation\/NetworkLib\/HTTPHeaders"],"generated":true}],"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/networklib\/sendingandreceiving"]}],"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"This example uses "},{"isActive":true,"type":"reference","identifier":"doc:\/\/NetworkLib\/documentation\/NetworkLib\/RawSocket"},{"type":"text","text":" to send an HTTP\/1.1 request over TLS. It prints the raw response, including HTTP headers, rather than decoding an HTTP response object."}]},{"text":"Exchange bytes over TLS","anchor":"Exchange-bytes-over-TLS","type":"heading","level":3},{"code":["import Foundation","import NetworkLib","","func fetchExample() async throws {","    let configuration = RawSocketConfiguration(","        \"example.com\",","        .https,","        isSecure: true,","        sni: \"example.com\",","        timeout: 15","    )","    let socket = try RawSocket(configuration)","","    do {","        let info = try await socket.connect()","        print(\"Connected to\", info.remoteEndpoint)","","        let request = \"GET \/ HTTP\/1.1\\r\\nHost: example.com\\r\\nConnection: close\\r\\n\\r\\n\"","        try await socket.send(Data(request.utf8))","","        while let data = try await socket.receiveNext() {","            print(String(decoding: data, as: UTF8.self), terminator: \"\")","        }","        await socket.cancel()","    } catch {","        await socket.cancel()","        throw error","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Call "},{"type":"codeVoice","code":"try await fetchExample()"},{"type":"text","text":" from an asynchronous context. The request asks the server to close the connection after the response, so the loop ends when "},{"type":"codeVoice","code":"receiveNext()"},{"type":"text","text":" returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"TCP is a byte stream. A receive block can contain part of a message or several messages, and even a UTF-8 character can span blocks. The printing above is intended for inspecting this example’s response; a real protocol implementation should buffer and decode according to its framing rules."}]},{"text":"Handle timeouts and cancellation","anchor":"Handle-timeouts-and-cancellation","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"The configuration’s "},{"type":"codeVoice","code":"timeout"},{"type":"text","text":" is an inactivity timeout in seconds, not a total request deadline. Socket failures are reported as "},{"type":"codeVoice","code":"NWError"},{"type":"text","text":", including "},{"type":"codeVoice","code":"NWError.posix(.ETIMEDOUT)"},{"type":"text","text":" when the timeout expires."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Cancelling a task waiting on a socket’s asynchronous connect, send, or receive operation permanently cancels the socket. Cancellation is reported through "},{"type":"codeVoice","code":"NWError"},{"type":"text","text":", rather than necessarily as "},{"type":"codeVoice","code":"CancellationError"},{"type":"text","text":". Both success and failure paths above await cleanup. Create a new socket for another connection."}]},{"text":"Run the CLI example","anchor":"Run-the-CLI-example","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"From a local checkout of NetworkLib, run this command in the directory containing "},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":":"}]},{"code":["swift run Examples async"],"type":"codeListing","syntax":"sh"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Requires Internet access. The CLI logs each receive block, then prints the collected raw HTTP response and closes the socket."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The runnable implementation is in "},{"type":"codeVoice","code":"Sources\/Examples\/SendingAndReceivingExample.swift"},{"type":"text","text":". See "},{"isActive":true,"type":"reference","identifier":"doc:\/\/NetworkLib\/documentation\/NetworkLib\/RunningExamples"},{"type":"text","text":" for tool requirements, the complete command list, and shared CLI behavior."}]}],"kind":"content"}],"references":{"doc://NetworkLib/documentation/NetworkLib/UsingCallbacks":{"identifier":"doc:\/\/NetworkLib\/documentation\/NetworkLib\/UsingCallbacks","type":"topic","role":"article","title":"Using Completion Handlers","abstract":[{"text":"Connect and send data using the callback-based socket API.","type":"text"}],"kind":"article","url":"\/documentation\/networklib\/usingcallbacks"},"doc://NetworkLib/documentation/NetworkLib/HTTPHeaders":{"identifier":"doc:\/\/NetworkLib\/documentation\/NetworkLib\/HTTPHeaders","type":"topic","role":"article","title":"Working with HTTP Headers","abstract":[{"text":"Use typed header keys with Foundation requests.","type":"text"}],"kind":"article","url":"\/documentation\/networklib\/httpheaders"},"doc://NetworkLib/documentation/NetworkLib/TypedMessages":{"identifier":"doc:\/\/NetworkLib\/documentation\/NetworkLib\/TypedMessages","type":"topic","role":"article","title":"Exchanging Typed UDP Messages","abstract":[{"text":"Represent a UTF-8 datagram with the socket’s message protocols.","type":"text"}],"kind":"article","url":"\/documentation\/networklib\/typedmessages"},"doc://NetworkLib/documentation/NetworkLib/RunningExamples":{"role":"article","identifier":"doc:\/\/NetworkLib\/documentation\/NetworkLib\/RunningExamples","type":"topic","kind":"article","url":"\/documentation\/networklib\/runningexamples","abstract":[{"type":"text","text":"Run the documented API examples from the terminal using the repository’s Examples target."}],"title":"Running the Examples"},"doc://NetworkLib/documentation/NetworkLib":{"identifier":"doc:\/\/NetworkLib\/documentation\/NetworkLib","kind":"symbol","title":"NetworkLib","role":"collection","type":"topic","url":"\/documentation\/networklib","abstract":[{"text":"Build socket connections with Swift concurrency and Apple’s Network framework.","type":"text"}]},"doc://NetworkLib/documentation/NetworkLib/UsingProxies":{"identifier":"doc:\/\/NetworkLib\/documentation\/NetworkLib\/UsingProxies","type":"topic","role":"article","title":"Connecting Through an HTTP Proxy","abstract":[{"text":"Configure an HTTP CONNECT tunnel with optional authentication.","type":"text"}],"kind":"article","url":"\/documentation\/networklib\/usingproxies"},"doc://NetworkLib/documentation/NetworkLib/RawSocket":{"kind":"symbol","type":"topic","identifier":"doc:\/\/NetworkLib\/documentation\/NetworkLib\/RawSocket","abstract":[{"text":"A socket that sends and receives raw data or protocol-framed messages over a Network framework connection.","type":"text"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RawSocket","kind":"identifier"}],"title":"RawSocket","role":"symbol","navigatorTitle":[{"text":"RawSocket","kind":"identifier"}],"url":"\/documentation\/networklib\/rawsocket"}}}