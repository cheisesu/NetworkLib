{"hierarchy":{"paths":[["doc:\/\/NetworkLib\/documentation\/NetworkLib"]]},"kind":"article","metadata":{"modules":[{"name":"NetworkLib"}],"title":"Exchanging Typed UDP Messages","roleHeading":"Article","role":"article"},"abstract":[{"type":"text","text":"Represent a UTF-8 datagram with the socket’s message protocols."}],"identifier":{"url":"doc:\/\/NetworkLib\/documentation\/NetworkLib\/TypedMessages","interfaceLanguage":"swift"},"sections":[],"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/NetworkLib\/documentation\/NetworkLib\/SendingAndReceiving"],"anchor":"Related-Documentation"},{"generated":true,"title":"API usage examples","identifiers":["doc:\/\/NetworkLib\/documentation\/NetworkLib\/RunningExamples","doc:\/\/NetworkLib\/documentation\/NetworkLib\/SendingAndReceiving","doc:\/\/NetworkLib\/documentation\/NetworkLib\/UsingCallbacks","doc:\/\/NetworkLib\/documentation\/NetworkLib\/UsingProxies","doc:\/\/NetworkLib\/documentation\/NetworkLib\/HTTPHeaders"],"anchor":"API-usage-examples"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"paths":["\/documentation\/networklib\/typedmessages"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"Conform a value type to ","type":"text"},{"identifier":"doc:\/\/NetworkLib\/documentation\/NetworkLib\/RawSocketSendMessage","type":"reference","isActive":true},{"text":" and ","type":"text"},{"identifier":"doc:\/\/NetworkLib\/documentation\/NetworkLib\/RawSocketReceiveMessage","type":"reference","isActive":true},{"text":" to encode and decode messages. UDP preserves datagram boundaries, making it suitable for this small example without a custom application framer.","type":"text"}]},{"type":"heading","text":"Define the message","anchor":"Define-the-message","level":3},{"syntax":"swift","type":"codeListing","code":["import Foundation","import Network","import NetworkLib","","struct TextDatagram: RawSocketSendMessage, RawSocketReceiveMessage {","    let text: String","","    var context: NWConnection.ContentContext {","        .defaultMessage","    }","","    var content: Data? {","        Data(text.utf8)","    }","","    init(text: String) {","        self.text = text","    }","","    init?(from context: NWConnection.ContentContext, with content: Data?) {","        guard let content, let text = String(data: content, encoding: .utf8) else {","            return nil","        }","        self.text = text","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"The computed content context avoids storing framework metadata in the value. Returning ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" from the decoding initializer rejects a message; the receive operation then reports ","type":"text"},{"type":"codeVoice","code":"NWError.posix(.EBADMSG)"},{"text":".","type":"text"}]},{"type":"heading","text":"Send and receive a datagram","anchor":"Send-and-receive-a-datagram","level":3},{"type":"paragraph","inlineContent":[{"text":"Place this function alongside ","type":"text"},{"type":"codeVoice","code":"TextDatagram"},{"text":". Run a local UDP echo service on port 9001 that returns each received datagram unchanged.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["func exchangeDatagram() async throws -> String {","    let configuration = RawSocketConfiguration(","        \"127.0.0.1\",","        9001,","        isSecure: false,","        transport: .udp,","        timeout: 5","    )","    let socket = try RawSocket(configuration)","","    do {","        try await socket.connect()","        try await socket.sendMessage(TextDatagram(text: \"hello\"))","        let reply = try await socket.receiveNextMessage(of: TextDatagram.self)","        await socket.cancel()","        return reply.text","    } catch {","        await socket.cancel()","        throw error","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"UDP doesn’t guarantee delivery or ordering. A successful connect doesn’t establish that an echo service is listening; a missing reply can result in an error or timeout. This local example uses plaintext UDP. A DTLS-enabled service requires ","type":"text"},{"type":"codeVoice","code":"isSecure: true"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"These protocols don’t add framing to a TCP byte stream. For typed messages over TCP, install a suitable Network framework application protocol through the configuration’s ","type":"text"},{"type":"codeVoice","code":"additionalProtocols"},{"text":" and supply the metadata that protocol expects.","type":"text"}]},{"type":"heading","text":"Run the CLI example","anchor":"Run-the-CLI-example","level":3},{"type":"paragraph","inlineContent":[{"text":"From a local checkout of NetworkLib, run this command in the directory containing ","type":"text"},{"code":"Package.swift","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","code":["swift run Examples udp"],"syntax":"sh"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Start this UDP echo server in another terminal first (requires Python 3):"}]},{"type":"codeListing","syntax":"sh","code":["python3 -u - <<'PYTHON'","import socket","s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)","s.bind((\"127.0.0.1\", 9001))","print(\"UDP echo ready\")","while True:","    data, addr = s.recvfrom(65535)","    s.sendto(data, addr)","PYTHON"]},{"type":"paragraph","inlineContent":[{"text":"The CLI sends a typed datagram, decodes the reply, verifies that it matches, and closes the socket. Stop the echo server with Control-C when finished.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The runnable implementation is in ","type":"text"},{"code":"Sources\/Examples\/TypedMessagesExample.swift","type":"codeVoice"},{"text":". See ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/NetworkLib\/documentation\/NetworkLib\/RunningExamples"},{"text":" for tool requirements, the complete command list, and shared CLI behavior.","type":"text"}]}]}],"references":{"doc://NetworkLib/documentation/NetworkLib":{"identifier":"doc:\/\/NetworkLib\/documentation\/NetworkLib","kind":"symbol","title":"NetworkLib","role":"collection","type":"topic","url":"\/documentation\/networklib","abstract":[{"text":"Build socket connections with Swift concurrency and Apple’s Network framework.","type":"text"}]},"doc://NetworkLib/documentation/NetworkLib/RunningExamples":{"role":"article","identifier":"doc:\/\/NetworkLib\/documentation\/NetworkLib\/RunningExamples","type":"topic","kind":"article","url":"\/documentation\/networklib\/runningexamples","abstract":[{"type":"text","text":"Run the documented API examples from the terminal using the repository’s Examples target."}],"title":"Running the Examples"},"doc://NetworkLib/documentation/NetworkLib/SendingAndReceiving":{"kind":"article","title":"Sending and Receiving Data","abstract":[{"text":"Connect securely, send bytes, and read a response with async\/await.","type":"text"}],"identifier":"doc:\/\/NetworkLib\/documentation\/NetworkLib\/SendingAndReceiving","role":"article","url":"\/documentation\/networklib\/sendingandreceiving","type":"topic"},"doc://NetworkLib/documentation/NetworkLib/UsingProxies":{"identifier":"doc:\/\/NetworkLib\/documentation\/NetworkLib\/UsingProxies","type":"topic","role":"article","title":"Connecting Through an HTTP Proxy","abstract":[{"text":"Configure an HTTP CONNECT tunnel with optional authentication.","type":"text"}],"kind":"article","url":"\/documentation\/networklib\/usingproxies"},"doc://NetworkLib/documentation/NetworkLib/RawSocketReceiveMessage":{"kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RawSocketReceiveMessage","kind":"identifier"}],"abstract":[{"type":"text","text":"A type that can decode a complete Network framework message received by a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/NetworkLib\/documentation\/NetworkLib\/RawSocket"},{"type":"text","text":"."}],"title":"RawSocketReceiveMessage","identifier":"doc:\/\/NetworkLib\/documentation\/NetworkLib\/RawSocketReceiveMessage","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"RawSocketReceiveMessage"}],"url":"\/documentation\/networklib\/rawsocketreceivemessage","type":"topic"},"doc://NetworkLib/documentation/NetworkLib/RawSocketSendMessage":{"kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RawSocketSendMessage","kind":"identifier"}],"abstract":[{"type":"text","text":"A type that supplies the metadata and optional payload for a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/NetworkLib\/documentation\/NetworkLib\/RawSocket"},{"type":"text","text":" message-send operation."}],"identifier":"doc:\/\/NetworkLib\/documentation\/NetworkLib\/RawSocketSendMessage","title":"RawSocketSendMessage","role":"symbol","navigatorTitle":[{"text":"RawSocketSendMessage","kind":"identifier"}],"url":"\/documentation\/networklib\/rawsocketsendmessage","type":"topic"},"doc://NetworkLib/documentation/NetworkLib/RawSocket":{"kind":"symbol","type":"topic","identifier":"doc:\/\/NetworkLib\/documentation\/NetworkLib\/RawSocket","abstract":[{"text":"A socket that sends and receives raw data or protocol-framed messages over a Network framework connection.","type":"text"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RawSocket","kind":"identifier"}],"title":"RawSocket","role":"symbol","navigatorTitle":[{"text":"RawSocket","kind":"identifier"}],"url":"\/documentation\/networklib\/rawsocket"},"doc://NetworkLib/documentation/NetworkLib/UsingCallbacks":{"identifier":"doc:\/\/NetworkLib\/documentation\/NetworkLib\/UsingCallbacks","type":"topic","role":"article","title":"Using Completion Handlers","abstract":[{"text":"Connect and send data using the callback-based socket API.","type":"text"}],"kind":"article","url":"\/documentation\/networklib\/usingcallbacks"},"doc://NetworkLib/documentation/NetworkLib/HTTPHeaders":{"identifier":"doc:\/\/NetworkLib\/documentation\/NetworkLib\/HTTPHeaders","type":"topic","role":"article","title":"Working with HTTP Headers","abstract":[{"text":"Use typed header keys with Foundation requests.","type":"text"}],"kind":"article","url":"\/documentation\/networklib\/httpheaders"}}}