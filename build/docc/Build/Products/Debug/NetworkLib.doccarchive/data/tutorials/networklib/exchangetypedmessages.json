"}]},{"sections":[{"kind":"task","reference":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ConnectThroughProxy#Separate-proxy-and-destination-settings"},{"kind":"assessment","reference":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ConnectThroughProxy#Check-Your-Understanding"}],"reference":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ConnectThroughProxy"}],"reference":"doc:\/\/NetworkLib\/tutorials\/NetworkLibTutorials\/Advanced-Usage"}],"reference":"doc:\/\/NetworkLib\/tutorials\/NetworkLibTutorials"},"metadata":{"role":"project","title":"Design Typed UDP Messages","categoryPathComponent":"NetworkLibTutorials","category":"NetworkLib"},"kind":"project","identifier":{"url":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ExchangeTypedMessages","interfaceLanguage":"swift"},"sections":[{"estimatedTimeInMinutes":20,"kind":"hero","title":"Design Typed UDP Messages","chapter":"Advanced Usage","content":[{"type":"paragraph","inlineContent":[{"text":"Move from raw bytes to a type that supplies outgoing content and validates incoming messages. Complete ","type":"text"},{"identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/BridgeCallbacks","isActive":true,"type":"reference"},{"text":" first. UDP supplies message boundaries for this example.","type":"text"}]}]},{"kind":"tasks","tasks":[{"title":"Encode, decode, and validate datagrams","contentSection":[{"kind":"fullWidth","content":[{"inlineContent":[{"text":"Follow the steps in order, then check your understanding below.","type":"text"}],"type":"paragraph"}]}],"stepsSection":[{"code":"Messages-01.swift","caption":[],"media":null,"runtimePreview":null,"content":[{"inlineContent":[{"text":"Open ","type":"text"},{"type":"codeVoice","code":"Sources\/Examples\/TypedMessagesExample.swift"},{"text":". Define the value’s UTF-8 payload and computed content context. The failable receive initializer rejects invalid UTF-8. Returning nil produces a receive error such as NWError.posix(.EBADMSG).","type":"text"}],"type":"paragraph"}],"type":"step"},{"code":"Messages-02.swift","caption":[],"media":null,"runtimePreview":null,"content":[{"inlineContent":[{"text":"Add the runnable exchange. Choose plaintext UDP for the local echo service, send a TextDatagram, request a typed reply, and check the echoed text. Await cleanup on every path.","type":"text"}],"type":"paragraph"}],"type":"step"},{"code":null,"caption":[],"media":null,"runtimePreview":null,"content":[{"inlineContent":[{"text":"Start the Python UDP echo server shown in ","type":"text"},{"identifier":"doc:\/\/NetworkLib\/documentation\/NetworkLib\/TypedMessages","isActive":true,"type":"reference"},{"type":"text","text":", then run "},{"code":"swift run Examples udp","type":"codeVoice"},{"type":"text","text":". Expect the decoded reply and "},{"type":"codeVoice","code":"Echo matched; socket closed."},{"type":"text","text":" Stop the server with Control-C afterward. UDP does not guarantee delivery or ordering; a ready connection does not prove that a server is listening."}],"type":"paragraph"}],"type":"step"},{"code":null,"caption":[],"media":null,"runtimePreview":null,"content":[{"inlineContent":[{"type":"text","text":"As an exercise, make the echo server reply with invalid UTF-8, then repeat the command and observe the error. For typed messages over TCP, these value protocols alone do not provide framing. Install a suitable Network framework application protocol through additionalProtocols and supply its required metadata. Continue with "},{"identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ConnectThroughProxy","isActive":true,"type":"reference"},{"type":"text","text":"."}],"type":"paragraph"}],"type":"step"}],"anchor":"Encode-decode-and-validate-datagrams"}]},{"kind":"assessments","anchor":"Check-Your-Understanding","assessments":[{"title":[{"inlineContent":[{"type":"text","text":"What gives this example its message boundaries?"}],"type":"paragraph"}],"type":"multiple-choice","content":[],"choices":[{"justification":[{"inlineContent":[{"type":"text","text":"The message protocols encode and decode values; they do not add framing to an unframed TCP stream."}],"type":"paragraph"}],"content":[{"inlineContent":[{"type":"text","text":"UDP datagram boundaries."}],"type":"paragraph"}],"isCorrect":true},{"content":[{"inlineContent":[{"text":"Conforming a Swift type automatically frames any transport.","type":"text"}],"type":"paragraph"}],"justification":[{"inlineContent":[{"text":"The message protocols encode and decode values; they do not add framing to an unframed TCP stream.","type":"text"}],"type":"paragraph"}],"isCorrect":false}]}]},{"kind":"callToAction","title":"Configure Authenticated Proxy Connections","featuredEyebrow":"Tutorial","action":{"identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ConnectThroughProxy","isActive":true,"overridingTitle":"Get started","overridingTitleInlineContent":[{"type":"text","text":"Get started"}],"type":"reference"},"abstract":[{"type":"text","text":"Combine configuration, TLS, validation, and the existing asynchronous transfer to connect through an HTTP CONNECT proxy. Complete "},{"type":"reference","isActive":true,"identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ExchangeTypedMessages"},{"text":" first. You must supply a running proxy; the CLI does not create one. Requires macOS 12.3 or later.","type":"text"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"paths":["\/tutorials\/networklib\/exchangetypedmessages"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://NetworkLib/tutorials/NetworkLib/ExchangeTypedMessages#Encode-decode-and-validate-datagrams":{"kind":"section","identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ExchangeTypedMessages#Encode-decode-and-validate-datagrams","type":"section","abstract":[{"text":"Move from raw bytes to a type that supplies outgoing content and validates incoming messages. Complete ","type":"text"},{"isActive":true,"identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/BridgeCallbacks","type":"reference"},{"text":" first. UDP supplies message boundaries for this example.","type":"text"}],"title":"Encode, decode, and validate datagrams","role":"pseudoSymbol","url":"\/tutorials\/networklib\/exchangetypedmessages#Encode-decode-and-validate-datagrams"},"doc://NetworkLib/tutorials/NetworkLibTutorials/Foundations":{"kind":"article","identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLibTutorials\/Foundations","type":"topic","abstract":[],"title":"Foundations","role":"article","url":"\/tutorials\/networklibtutorials\/foundations"},"doc://NetworkLib/tutorials/NetworkLib/BridgeCallbacks":{"kind":"project","identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/BridgeCallbacks","type":"topic","abstract":[{"text":"Use the callback API while keeping an asynchronous CLI alive until the work finishes. Complete ","type":"text"},{"isActive":true,"identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ManageSocketLifetime","type":"reference"},{"text":" first. This lesson uses a local plaintext TCP listener.","type":"text"}],"estimatedTime":"15min","title":"Work with Completion Handlers","role":"project","url":"\/tutorials\/networklib\/bridgecallbacks"},"doc://NetworkLib/tutorials/NetworkLibTutorials":{"identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLibTutorials","kind":"overview","title":"Build Your NetworkLib Skills","role":"overview","type":"topic","url":"\/tutorials\/networklibtutorials","abstract":[{"type":"text","text":"Learn to configure connections, exchange bytes, manage cancellation, and use typed messages and proxies. Work through six guided lessons using the existing Examples target in a local checkout. You need Swift 6 on macOS and basic familiarity with Swift functions, errors, and async\/await. See "},{"isActive":true,"identifier":"doc:\/\/NetworkLib\/documentation\/NetworkLib\/RunningExamples","type":"reference"},{"text":" for build requirements. Code snapshots belong to individual steps; don’t add all snapshots to a target together.","type":"text"}]},"doc://NetworkLib/tutorials/NetworkLib/ConfigureASocket":{"kind":"project","identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ConfigureASocket","type":"topic","abstract":[{"text":"Learn how a configuration describes a connection before any network activity begins. Start with a local checkout of NetworkLib, a Swift 6 toolchain, and the existing Examples target on macOS. See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/NetworkLib\/documentation\/NetworkLib\/RunningExamples","type":"reference"},{"text":" for build requirements.","type":"text"}],"estimatedTime":"10min","title":"Configure Your First Socket","role":"project","url":"\/tutorials\/networklib\/configureasocket"},"doc://NetworkLib/tutorials/NetworkLib/BridgeCallbacks#Sequence-callback-operations":{"kind":"section","identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/BridgeCallbacks#Sequence-callback-operations","type":"section","abstract":[{"text":"Use the callback API while keeping an asynchronous CLI alive until the work finishes. Complete ","type":"text"},{"isActive":true,"identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ManageSocketLifetime","type":"reference"},{"text":" first. This lesson uses a local plaintext TCP listener.","type":"text"}],"title":"Sequence callback operations","role":"pseudoSymbol","url":"\/tutorials\/networklib\/bridgecallbacks#Sequence-callback-operations"},"Messages-02.swift":{"syntax":"swift","highlights":[{"line":20},{"line":21},{"line":22},{"line":23},{"line":24},{"line":25},{"line":26},{"line":27},{"line":28},{"line":29},{"line":30},{"line":31},{"line":32},{"line":33},{"line":34},{"line":35},{"line":36},{"line":37},{"line":38},{"line":39},{"line":40},{"line":41},{"line":42},{"line":43},{"line":44},{"line":45},{"line":46}],"fileName":"TypedMessagesExample.swift","fileType":"swift","type":"file","content":["import Foundation","import Network","import NetworkLib","","struct TextDatagram: RawSocketSendMessage, RawSocketReceiveMessage {","    let text: String","","    var context: NWConnection.ContentContext { .defaultMessage }","    var content: Data? { Data(text.utf8) }","","    init(text: String) {","        self.text = text","    }","","    init?(from context: NWConnection.ContentContext, with content: Data?) {","        guard let content, let text = String(data: content, encoding: .utf8) else { return nil }","        self.text = text","    }","}","","enum TypedMessagesExample {","    static func run() async throws {","        ExampleCLI.log(\"First start the UDP echo server from --help in another terminal.\")","        ExampleCLI.log(\"Using plaintext UDP at 127.0.0.1:9001; waiting up to 5 seconds of inactivity.\")","        let configuration = RawSocketConfiguration(","            \"127.0.0.1\", 9001, isSecure: false, transport: .udp, timeout: 5","        )","        let socket = try RawSocket(configuration)","        do {","            try await socket.connect()","            let message = TextDatagram(text: \"hello from NetworkLib UDP\")","            ExampleCLI.log(\"Sending typed message: \\(message.text)\")","            try await socket.sendMessage(message)","            let reply = try await socket.receiveNextMessage(of: TextDatagram.self)","            ExampleCLI.log(\"Decoded reply: \\(reply.text)\")","            guard reply.text == message.text else {","                throw ExampleError.message(\"The server's reply did not match the sent message.\")","            }","            await socket.cancel()","            ExampleCLI.log(\"Echo matched; socket closed.\")","        } catch {","            await socket.cancel()","            throw error","        }","    }","}"],"identifier":"Messages-02.swift"},"doc://NetworkLib/tutorials/NetworkLib/ConnectThroughProxy#Separate-proxy-and-destination-settings":{"kind":"section","identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ConnectThroughProxy#Separate-proxy-and-destination-settings","type":"section","abstract":[{"text":"Combine configuration, TLS, validation, and the existing asynchronous transfer to connect through an HTTP CONNECT proxy. Complete ","type":"text"},{"isActive":true,"identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ExchangeTypedMessages","type":"reference"},{"text":" first. You must supply a running proxy; the CLI does not create one. Requires macOS 12.3 or later.","type":"text"}],"title":"Separate proxy and destination settings","role":"pseudoSymbol","url":"\/tutorials\/networklib\/connectthroughproxy#Separate-proxy-and-destination-settings"},"doc://NetworkLib/documentation/NetworkLib/RunningExamples":{"role":"article","identifier":"doc:\/\/NetworkLib\/documentation\/NetworkLib\/RunningExamples","type":"topic","kind":"article","url":"\/documentation\/networklib\/runningexamples","abstract":[{"type":"text","text":"Run the documented API examples from the terminal using the repository’s Examples target."}],"title":"Running the Examples"},"doc://NetworkLib/tutorials/NetworkLib/TransferBytes":{"kind":"project","identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/TransferBytes","type":"topic","abstract":[{"text":"Turn a configuration into a TLS connection, send an HTTP\/1.1 request, and collect the response. Complete ","type":"text"},{"isActive":true,"identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ConfigureASocket","type":"reference"},{"text":" first. This lesson requires Internet access.","type":"text"}],"estimatedTime":"15min","title":"Send and Receive over TLS","role":"project","url":"\/tutorials\/networklib\/transferbytes"},"doc://NetworkLib/tutorials/NetworkLib/ManageSocketLifetime#Own-the-task-and-the-socket-lifetime":{"kind":"section","identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ManageSocketLifetime#Own-the-task-and-the-socket-lifetime","type":"section","abstract":[{"text":"Add cancellation and error reporting around the transfer from ","type":"text"},{"isActive":true,"identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/TransferBytes","type":"referen