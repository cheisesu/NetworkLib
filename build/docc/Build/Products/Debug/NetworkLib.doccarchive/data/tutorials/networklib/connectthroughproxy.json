b\/ConfigureASocket","type":"reference"},{"text":" first. This lesson requires Internet access.","type":"text"}],"title":"Build an asynchronous request","role":"pseudoSymbol","url":"\/tutorials\/networklib\/transferbytes#Build-an-asynchronous-request"},"doc://NetworkLib/tutorials/NetworkLib/ExchangeTypedMessages":{"kind":"project","identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ExchangeTypedMessages","type":"topic","abstract":[{"text":"Move from raw bytes to a type that supplies outgoing content and validates incoming messages. Complete ","type":"text"},{"isActive":true,"identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/BridgeCallbacks","type":"reference"},{"text":" first. UDP supplies message boundaries for this example.","type":"text"}],"estimatedTime":"20min","title":"Design Typed UDP Messages","role":"project","url":"\/tutorials\/networklib\/exchangetypedmessages"},"doc://NetworkLib/tutorials/NetworkLib/ConnectThroughProxy#Check-Your-Understanding":{"titleInlineContent":[{"text":"Check Your Understanding","type":"text"}],"type":"link","title":"Check Your Understanding","identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ConnectThroughProxy#Check-Your-Understanding","url":"\/tutorials\/networklib\/connectthroughproxy#Check-Your-Understanding"},"doc://NetworkLib/tutorials/NetworkLib/TransferBytes#Check-Your-Understanding":{"titleInlineContent":[{"text":"Check Your Understanding","type":"text"}],"type":"link","title":"Check Your Understanding","identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/TransferBytes#Check-Your-Understanding","url":"\/tutorials\/networklib\/transferbytes#Check-Your-Understanding"},"doc://NetworkLib/tutorials/NetworkLib/ConfigureASocket#Check-Your-Understanding":{"titleInlineContent":[{"text":"Check Your Understanding","type":"text"}],"type":"link","title":"Check Your Understanding","identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ConfigureASocket#Check-Your-Understanding","url":"\/tutorials\/networklib\/configureasocket#Check-Your-Understanding"},"doc://NetworkLib/tutorials/NetworkLib/ManageSocketLifetime#Check-Your-Understanding":{"titleInlineContent":[{"text":"Check Your Understanding","type":"text"}],"type":"link","title":"Check Your Understanding","identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ManageSocketLifetime#Check-Your-Understanding","url":"\/tutorials\/networklib\/managesocketlifetime#Check-Your-Understanding"},"doc://NetworkLib/tutorials/NetworkLibTutorials/Advanced-Usage":{"kind":"article","identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLibTutorials\/Advanced-Usage","type":"topic","abstract":[],"title":"Advanced Usage","role":"article","url":"\/tutorials\/networklibtutorials\/advanced-usage"},"doc://NetworkLib/tutorials/NetworkLib/ConnectThroughProxy":{"kind":"project","identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ConnectThroughProxy","type":"topic","abstract":[{"text":"Combine configuration, TLS, validation, and the existing asynchronous transfer to connect through an HTTP CONNECT proxy. Complete ","type":"text"},{"isActive":true,"identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ExchangeTypedMessages","type":"reference"},{"text":" first. You must supply a running proxy; the CLI does not create one. Requires macOS 12.3 or later.","type":"text"}],"estimatedTime":"20min","title":"Configure Authenticated Proxy Connections","role":"project","url":"\/tutorials\/networklib\/connectthroughproxy"},"doc://NetworkLib/tutorials/NetworkLib/ExchangeTypedMessages#Check-Your-Understanding":{"titleInlineContent":[{"text":"Check Your Understanding","type":"text"}],"type":"link","title":"Check Your Understanding","identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ExchangeTypedMessages#Check-Your-Understanding","url":"\/tutorials\/networklib\/exchangetypedmessages#Check-Your-Understanding"},"doc://NetworkLib/tutorials/NetworkLib/BridgeCallbacks#Check-Your-Understanding":{"titleInlineContent":[{"text":"Check Your Understanding","type":"text"}],"type":"link","title":"Check Your Understanding","identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/BridgeCallbacks#Check-Your-Understanding","url":"\/tutorials\/networklib\/bridgecallbacks#Check-Your-Understanding"},"Proxy-01.swift":{"type":"file","content":["import Network","import NetworkLib","","@available(macOS 12.3, iOS 15.4, tvOS 15.4, *)","func makeProxiedConfiguration(host: String, port: NWEndpoint.Port) -> RawSocketConfiguration {","    let destination = RawSocketConfiguration(\"example.com\", .https, sni: \"example.com\", timeout: 15)","    let proxy = RawSocketConfiguration.Proxy(","        host: NWEndpoint.Host(host),","        port: port,","        isSecure: true,","        sni: host","    )","    return destination.using(proxy: proxy)","}"],"identifier":"Proxy-01.swift","highlights":[],"fileName":"ProxyConfiguration.swift","fileType":"swift","syntax":"swift"}}}