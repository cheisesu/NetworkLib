{"identifier":{"url":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ConnectThroughProxy","interfaceLanguage":"swift"},"kind":"project","hierarchy":{"modules":[{"projects":[{"reference":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ConfigureASocket","sections":[{"kind":"task","reference":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ConfigureASocket#Choose-transport-and-security"},{"kind":"assessment","reference":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ConfigureASocket#Check-Your-Understanding"}]},{"reference":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/TransferBytes","sections":[{"kind":"task","reference":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/TransferBytes#Build-an-asynchronous-request"},{"kind":"assessment","reference":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/TransferBytes#Check-Your-Understanding"}]},{"reference":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ManageSocketLifetime","sections":[{"kind":"task","reference":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ManageSocketLifetime#Own-the-task-and-the-socket-lifetime"},{"kind":"assessment","reference":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ManageSocketLifetime#Check-Your-Understanding"}]}],"reference":"doc:\/\/NetworkLib\/tutorials\/NetworkLibTutorials\/Foundations"},{"projects":[{"reference":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/BridgeCallbacks","sections":[{"kind":"task","reference":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/BridgeCallbacks#Sequence-callback-operations"},{"kind":"assessment","reference":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/BridgeCallbacks#Check-Your-Understanding"}]},{"sections":[{"kind":"task","reference":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ExchangeTypedMessages#Encode-decode-and-validate-datagrams"},{"kind":"assessment","reference":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ExchangeTypedMessages#Check-Your-Understanding"}],"reference":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ExchangeTypedMessages"},{"sections":[{"kind":"task","reference":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ConnectThroughProxy#Separate-proxy-and-destination-settings"},{"kind":"assessment","reference":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ConnectThroughProxy#Check-Your-Understanding"}],"reference":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ConnectThroughProxy"}],"reference":"doc:\/\/NetworkLib\/tutorials\/NetworkLibTutorials\/Advanced-Usage"}],"paths":[["doc:\/\/NetworkLib\/tutorials\/NetworkLibTutorials","doc:\/\/NetworkLib\/tutorials\/NetworkLibTutorials\/$volume","doc:\/\/NetworkLib\/tutorials\/NetworkLibTutorials\/Advanced-Usage"]],"reference":"doc:\/\/NetworkLib\/tutorials\/NetworkLibTutorials"},"sections":[{"content":[{"inlineContent":[{"text":"Combine configuration, TLS, validation, and the existing asynchronous transfer to connect through an HTTP CONNECT proxy. Complete ","type":"text"},{"identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ExchangeTypedMessages","type":"reference","isActive":true},{"text":" first. You must supply a running proxy; the CLI does not create one. Requires macOS 12.3 or later.","type":"text"}],"type":"paragraph"}],"estimatedTimeInMinutes":20,"chapter":"Advanced Usage","kind":"hero","title":"Configure Authenticated Proxy Connections"},{"kind":"tasks","tasks":[{"title":"Separate proxy and destination settings","contentSection":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Follow the steps in order, then check your understanding below.","type":"text"}]}],"kind":"fullWidth"}],"stepsSection":[{"type":"step","content":[{"inlineContent":[{"text":"Inspect this helper in a scratch file in the Examples target. The destination remains example.com over TLS. The proxy has its own host, port, and security settings. Applying using(proxy:) returns a new destination configuration.","type":"text"}],"type":"paragraph"}],"runtimePreview":null,"caption":[],"media":null,"code":"Proxy-01.swift"},{"type":"step","content":[{"type":"paragraph","inlineContent":[{"text":"Open ","type":"text"},{"code":"Sources\/Examples\/ProxyExample.swift","type":"codeVoice"},{"text":". Read the environment settings, validate the port and TLS flag, and require both credential fields when authentication is used. Pass the resulting configuration to the shared transfer implementation. Credentials aren’t included in the example’s progress messages.","type":"text"}]}],"runtimePreview":null,"caption":[],"media":null,"code":"Proxy-02.swift"},{"media":null,"runtimePreview":null,"type":"step","content":[{"type":"paragraph","inlineContent":[{"text":"Set NL_PROXY_HOST and NL_PROXY_PORT to your proxy. For a plaintext local proxy on port 8080, run ","type":"text"},{"code":"NL_PROXY_HOST=localhost NL_PROXY_PORT=8080 NL_PROXY_TLS=false swift run Examples proxy","type":"codeVoice"},{"text":". Otherwise use your actual proxy address and security mode. See ","type":"text"},{"identifier":"doc:\/\/NetworkLib\/documentation\/NetworkLib\/UsingProxies","isActive":true,"type":"reference"},{"text":" for all settings.","type":"text"}]}],"caption":[],"code":null},{"runtimePreview":null,"caption":[],"media":null,"type":"step","content":[{"inlineContent":[{"text":"If needed, set NL_PROXY_USERNAME and NL_PROXY_PASSWORD in the environment before running. TLS to the proxy is enabled by default and requires a trusted certificate; TLS to example.com remains enabled even when the proxy connection is plaintext. Expect connection progress and the raw destination response. As a final exercise, compare this run with ","type":"text"},{"type":"codeVoice","code":"swift run Examples async"},{"text":" and explain which connection settings changed.","type":"text"}],"type":"paragraph"}],"code":null}],"anchor":"Separate-proxy-and-destination-settings"}]},{"kind":"assessments","anchor":"Check-Your-Understanding","assessments":[{"choices":[{"justification":[{"inlineContent":[{"text":"The proxy settings govern the first connection; the destination configuration governs the connection inside the tunnel.","type":"text"}],"type":"paragraph"}],"content":[{"inlineContent":[{"type":"text","text":"No; the proxy and destination have independent security settings."}],"type":"paragraph"}],"isCorrect":true},{"justification":[{"inlineContent":[{"text":"The proxy settings govern the first connection; the destination configuration governs the connection inside the tunnel.","type":"text"}],"type":"paragraph"}],"content":[{"inlineContent":[{"text":"Yes; one security setting controls both connections.","type":"text"}],"type":"paragraph"}],"isCorrect":false}],"title":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Does disabling TLS to the proxy also disable destination TLS?"}]}],"content":[],"type":"multiple-choice"}]}],"metadata":{"categoryPathComponent":"NetworkLibTutorials","category":"NetworkLib","title":"Configure Authenticated Proxy Connections","role":"project"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/tutorials\/networklib\/connectthroughproxy"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://NetworkLib/tutorials/NetworkLib/ExchangeTypedMessages#Encode-decode-and-validate-datagrams":{"kind":"section","identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ExchangeTypedMessages#Encode-decode-and-validate-datagrams","type":"section","abstract":[{"text":"Move from raw bytes to a type that supplies outgoing content and validates incoming messages. Complete ","type":"text"},{"isActive":true,"identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/BridgeCallbacks","type":"reference"},{"text":" first. UDP supplies message boundaries for this example.","type":"text"}],"title":"Encode, decode, and validate datagrams","role":"pseudoSymbol","url":"\/tutorials\/networklib\/exchangetypedmessages#Encode-decode-and-validate-datagrams"},"doc://NetworkLib/tutorials/NetworkLibTutorials/Foundations":{"kind":"article","identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLibTutorials\/Foundations","type":"topic","abstract":[],"title":"Foundations","role":"article","url":"\/tutorials\/networklibtutorials\/foundations"},"Proxy-02.swift":{"identifier":"Proxy-02.swift","syntax":"swift","highlights":[],"fileType":"swift","content":["import Foundation","import Network","import NetworkLib","","enum ProxyExample {","    static func run() async throws {","        ExampleCLI.log(\"Requires an HTTP CONNECT proxy. See --help for environment variables.\")","        guard #available(macOS 12.3, iOS 15.4, tvOS 15.4, *) else {","            throw ExampleError.message(\"Proxy connections require macOS 12.3 or later.\")","        }","        let environment = ProcessInfo.processInfo.environment","        guard let host = environment[\"NL_PROXY_HOST\"], !host.isEmpty,","              let portText = environment[\"NL_PROXY_PORT\"],","              let portNumber = UInt16(portText), portNumber > 0,","              let port = NWEndpoint.Port(rawValue: portNumber) else {","            throw ExampleError.message(\"Set NL_PROXY_HOST and NL_PROXY_PORT (1–65535).\")","        }","        let tlsText = environment[\"NL_PROXY_TLS\"] ?? \"true\"","        guard tlsText == \"true\" || tlsText == \"false\" else {","            throw ExampleError.message(\"NL_PROXY_TLS must be true or false.\")","        }","        let username = environment[\"NL_PROXY_USERNAME\"]","        let password = environment[\"NL_PROXY_PASSWORD\"]","        guard (username == nil) == (password == nil) else {","            throw ExampleError.message(\"Set both NL_PROXY_USERNAME and NL_PROXY_PASSWORD, or neither.\")","        }","        var authorization: HTTPAuthorization?","        if let username, let password {","            authorization = .basic(userName: username, password: password)","        }","        let proxy = RawSocketConfiguration.Proxy(","            host: NWEndpoint.Host(host),","            port: port,","            isSecure: tlsText == \"true\",","            sni: tlsText == \"true\" ? host : nil,","            authorization: authorization","        )","        ExampleCLI.log(\"Proxy configured (TLS: \\(tlsText), authentication: \\(authorization != nil)).\")","        let destination = RawSocketConfiguration(\"example.com\", .https, sni: \"example.com\", timeout: 15)","        try await SendingAndReceivingExample.exchange(using: destination.using(proxy: proxy))","    }","}"],"type":"file","fileName":"ProxyExample.swift"},"doc://NetworkLib/tutorials/NetworkLib/BridgeCallbacks":{"kind":"project","identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/BridgeCallbacks","type":"topic","abstract":[{"text":"Use the callback API while keeping an asynchronous CLI alive until the work finishes. Complete ","type":"text"},{"isActive":true,"identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ManageSocketLifetime","type":"reference"},{"text":" first. This lesson uses a local plaintext TCP listener.","type":"text"}],"estimatedTime":"15min","title":"Work with Completion Handlers","role":"project","url":"\/tutorials\/networklib\/bridgecallbacks"},"doc://NetworkLib/tutorials/NetworkLibTutorials":{"identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLibTutorials","kind":"overview","title":"Build Your NetworkLib Skills","role":"overview","type":"topic","url":"\/tutorials\/networklibtutorials","abstract":[{"type":"text","text":"Learn to configure connections, exchange bytes, manage cancellation, and use typed messages and proxies. Work through six guided lessons using the existing Examples target in a local checkout. You need Swift 6 on macOS and basic familiarity with Swift functions, errors, and async\/await. See "},{"isActive":true,"identifier":"doc:\/\/NetworkLib\/documentation\/NetworkLib\/RunningExamples","type":"reference"},{"text":" for build requirements. Code snapshots belong to individual steps; don’t add all snapshots to a target together.","type":"text"}]},"doc://NetworkLib/tutorials/NetworkLib/ConfigureASocket":{"kind":"project","identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ConfigureASocket","type":"topic","abstract":[{"tex