{"kind":"project","schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[{"kind":"hero","chapter":"Foundations","estimatedTimeInMinutes":15,"content":[{"type":"paragraph","inlineContent":[{"text":"Turn a configuration into a TLS connection, send an HTTP\/1.1 request, and collect the response. Complete ","type":"text"},{"identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ConfigureASocket","type":"reference","isActive":true},{"text":" first. This lesson requires Internet access.","type":"text"}]}],"title":"Send and Receive over TLS"},{"kind":"tasks","tasks":[{"stepsSection":[{"caption":[],"content":[{"inlineContent":[{"type":"text","text":"Work in "},{"type":"codeVoice","code":"Sources\/Examples\/SendingAndReceivingExample.swift"},{"type":"text","text":". Compare the connect-only snapshot with the existing implementation. Construct a socket, await readiness, inspect its endpoint, and await cancellation in both success and failure paths."}],"type":"paragraph"}],"type":"step","runtimePreview":null,"code":"Transfer-01.swift","media":null},{"caption":[],"content":[{"inlineContent":[{"type":"text","text":"Replace the connect-only implementation with this complete snapshot. Send a UTF-8 HTTP request with CRLF line endings. "},{"type":"codeVoice","code":"Connection: close"},{"type":"text","text":" asks this server to close the stream after its response. Receive repeatedly until the API returns nil, and impose a 1 MiB total limit independently of the receive block size."}],"type":"paragraph"}],"type":"step","runtimePreview":null,"code":"Transfer-02.swift","media":null},{"caption":[],"content":[{"inlineContent":[{"type":"text","text":"Run "},{"type":"codeVoice","code":"swift run Examples async"},{"type":"text","text":". Expect connection progress, received byte counts, a raw HTTP response, and a completion message. The HTTP status and body come from the remote server and may vary. A successful socket operation is not the same as an HTTP success status."}],"type":"paragraph"}],"type":"step","runtimePreview":null,"code":null,"media":null},{"caption":[],"content":[{"inlineContent":[{"type":"text","text":"Notice that the example decodes text only after collecting the response. TCP can split a message or a UTF-8 character across receives. For persistent connections, use your application protocol’s framing to decide when a response is complete instead of waiting for the server to close. Continue with "},{"isActive":true,"type":"reference","identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ManageSocketLifetime"},{"type":"text","text":"."}],"type":"paragraph"}],"type":"step","runtimePreview":null,"code":null,"media":null}],"anchor":"Build-an-asynchronous-request","title":"Build an asynchronous request","contentSection":[{"content":[{"inlineContent":[{"type":"text","text":"Follow the steps in order, then check your understanding below."}],"type":"paragraph"}],"kind":"fullWidth"}]}]},{"kind":"assessments","anchor":"Check-Your-Understanding","assessments":[{"choices":[{"content":[{"inlineContent":[{"type":"text","text":"No; buffer bytes according to the application protocol."}],"type":"paragraph"}],"isCorrect":true,"justification":[{"inlineContent":[{"type":"text","text":"TCP exposes a stream of bytes, so receive boundaries do not define message boundaries."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Yes; every send is matched by one receive."}],"type":"paragraph"}],"isCorrect":false,"justification":[{"inlineContent":[{"type":"text","text":"TCP exposes a stream of bytes, so receive boundaries do not define message boundaries."}],"type":"paragraph"}]}],"content":[],"title":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Does one TCP receive always contain one complete application message?"}]}],"type":"multiple-choice"}]},{"kind":"callToAction","abstract":[{"type":"text","text":"Add cancellation and error reporting around the transfer from "},{"isActive":true,"type":"reference","identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/TransferBytes"},{"type":"text","text":". Reuse the existing Examples target and its SendingAndReceivingExample implementation."}],"action":{"overridingTitleInlineContent":[{"text":"Get started","type":"text"}],"isActive":true,"overridingTitle":"Get started","type":"reference","identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ManageSocketLifetime"},"featuredEyebrow":"Tutorial","title":"Handle Errors and Cancellation"}],"variants":[{"paths":["\/tutorials\/networklib\/transferbytes"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/NetworkLib\/tutorials\/NetworkLibTutorials","doc:\/\/NetworkLib\/tutorials\/NetworkLibTutorials\/$volume","doc:\/\/NetworkLib\/tutorials\/NetworkLibTutorials\/Foundations"]],"modules":[{"reference":"doc:\/\/NetworkLib\/tutorials\/NetworkLibTutorials\/Foundations","projects":[{"sections":[{"kind":"task","reference":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ConfigureASocket#Choose-transport-and-security"},{"kind":"assessment","reference":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ConfigureASocket#Check-Your-Understanding"}],"reference":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ConfigureASocket"},{"reference":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/TransferBytes","sections":[{"kind":"task","reference":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/TransferBytes#Build-an-asynchronous-request"},{"kind":"assessment","reference":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/TransferBytes#Check-Your-Understanding"}]},{"sections":[{"kind":"task","reference":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ManageSocketLifetime#Own-the-task-and-the-socket-lifetime"},{"kind":"assessment","reference":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ManageSocketLifetime#Check-Your-Understanding"}],"reference":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ManageSocketLifetime"}]},{"reference":"doc:\/\/NetworkLib\/tutorials\/NetworkLibTutorials\/Advanced-Usage","projects":[{"sections":[{"kind":"task","reference":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/BridgeCallbacks#Sequence-callback-operations"},{"kind":"assessment","reference":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/BridgeCallbacks#Check-Your-Understanding"}],"reference":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/BridgeCallbacks"},{"sections":[{"kind":"task","reference":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ExchangeTypedMessages#Encode-decode-and-validate-datagrams"},{"kind":"assessment","reference":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ExchangeTypedMessages#Check-Your-Understanding"}],"reference":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ExchangeTypedMessages"},{"sections":[{"kind":"task","reference":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ConnectThroughProxy#Separate-proxy-and-destination-settings"},{"kind":"assessment","reference":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ConnectThroughProxy#Check-Your-Understanding"}],"reference":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ConnectThroughProxy"}]}],"reference":"doc:\/\/NetworkLib\/tutorials\/NetworkLibTutorials"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/TransferBytes"},"metadata":{"title":"Send and Receive over TLS","category":"NetworkLib","categoryPathComponent":"NetworkLibTutorials","role":"project"},"references":{"doc://NetworkLib/tutorials/NetworkLib/TransferBytes":{"kind":"project","identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/TransferBytes","type":"topic","abstract":[{"text":"Turn a configuration into a TLS connection, send an HTTP\/1.1 request, and collect the response. Complete ","type":"text"},{"isActive":true,"identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ConfigureASocket","type":"reference"},{"text":" first. This lesson requires Internet access.","type":"text"}],"estimatedTime":"15min","title":"Send and Receive over TLS","role":"project","url":"\/tutorials\/networklib\/transferbytes"},"doc://NetworkLib/tutorials/NetworkLib/ConfigureASocket#Check-Your-Understanding":{"titleInlineContent":[{"text":"Check Your Understanding","type":"text"}],"url":"\/tutorials\/networklib\/configureasocket#Check-Your-Understanding","title":"Check Your Understanding","type":"link","identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ConfigureASocket#Check-Your-Understanding"},"doc://NetworkLib/tutorials/NetworkLib/ManageSocketLifetime":{"kind":"project","identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ManageSocketLifetime","type":"topic","abstract":[{"text":"Add cancellation and error reporting around the transfer from ","type":"text"},{"isActive":true,"identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/TransferBytes","type":"reference"},{"text":". Reuse the existing Examples target and its SendingAndReceivingExample implementation.","type":"text"}],"estimatedTime":"15min","title":"Handle Errors and Cancellation","role":"project","url":"\/tutorials\/networklib\/managesocketlifetime"},"doc://NetworkLib/tutorials/NetworkLib/TransferBytes#Check-Your-Understanding":{"titleInlineContent":[{"text":"Check Your Understanding","type":"text"}],"url":"\/tutorials\/networklib\/transferbytes#Check-Your-Understanding","title":"Check Your Understanding","type":"link","identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/TransferBytes#Check-Your-Understanding"},"doc://NetworkLib/tutorials/NetworkLib/ConfigureASocket":{"kind":"project","identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ConfigureASocket","type":"topic","abstract":[{"text":"Learn how a configuration describes a connection before any network activity begins. Start with a local checkout of NetworkLib, a Swift 6 toolchain, and the existing Examples target on macOS. See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/NetworkLib\/documentation\/NetworkLib\/RunningExamples","type":"reference"},{"text":" for build requirements.","type":"text"}],"estimatedTime":"10min","title":"Configure Your First Socket","role":"project","url":"\/tutorials\/networklib\/configureasocket"},"doc://NetworkLib/tutorials/NetworkLibTutorials/Foundations":{"kind":"article","identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLibTutorials\/Foundations","type":"topic","abstract":[],"title":"Foundations","role":"article","url":"\/tutorials\/networklibtutorials\/foundations"},"Transfer-02.swift":{"fileName":"SendingAndReceivingExample.swift","highlights":[{"line":1},{"line":6},{"line":8},{"line":9},{"line":10},{"line":11},{"line":14},{"line":16},{"line":17},{"line":18},{"line":19},{"line":20},{"line":21},{"line":22},{"line":23},{"line":24},{"line":25},{"line":26},{"line":27},{"line":28},{"line":29},{"line":30},{"line":32}],"identifier":"Transfer-02.swift","syntax":"swift","fileType":"swift","content":["import Foundation","import NetworkLib","","enum SendingAndReceivingExample {","    static func run() async throws {","        ExampleCLI.log(\"Requires Internet access. Fetching https:\/\/example.com over TLS.\")","        let configuration = RawSocketConfiguration(\"example.com\", .https, sni: \"example.com\", timeout: 15)","        try await exchange(using: configuration)","    }","","    static func exchange(using configuration: RawSocketConfiguration) async throws {","        let socket = try RawSocket(configuration)","        do {","            ExampleCLI.log(\"Connecting…\")","            let info = try await socket.connect()","            ExampleCLI.log(\"Connected to \\(info.remoteEndpoint)\")","            let request = \"GET \/ HTTP\/1.1\\r\\nHost: example.com\\r\\nConnection: close\\r\\n\\r\\n\"","            ExampleCLI.log(\"Sending HTTP\/1.1 GET \/\")","            try await socket.send(Data(request.utf8))","            var response = Data()","            while let block = try await socket.receiveNext() {","                ExampleCLI.log(\"Received \\(block.count) bytes\")","                guard response.count + block.count <= 1_048_576 else {","                    throw ExampleError.message(\"Response exceeded the example's 1 MiB limit.\")","                }","                response.append(block)","            }","            \/\/ Decode after collecting the bytes so UTF-8 characters may span receive blocks.","            print(\"--- Raw HTTP response ---\")","            print(String(data: response, encoding: .utf8) ?? \"<Response contains non-UTF-8 data>\")","            await socket.cancel()","            ExampleCLI.log(\"Connection closed; received \\(response.count) bytes total.\")","        } catch {","            await socket.cancel()","            throw error","        }","    }","}"],"type":"file"},"doc://NetworkLib/tutorials/NetworkLib/BridgeCallbacks#Check-Your-Understanding":{"titleInlineContent":[{"text":"Check Your Understanding","type":"text"}],"url":"\/tutorials\/networklib\/bridgecallbacks#Check-Your-Understanding","title":"Check Your Understanding","type":"link","identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/BridgeCallbacks#Check-Your-Understanding"},"doc://NetworkLib/tutorials/NetworkLib/ExchangeTypedMessages":{"kind":"project","identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ExchangeTypedMessages","type":"topic","abstract":[{"text":"Move from raw bytes to a type that supplies outgoing content and validates incoming messages. Complete ","type":"text"},{"isActive":true,"identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/BridgeCallbacks","type":"reference"},{"text":" first. UDP supplies message boundaries for this example.","type":"text"}],"estimatedTime":"20min","title":"Design Typed UDP Messages","role":"project","url":"\/tutorials\/networklib\/exchangetypedmessages"},"doc://NetworkLib/tutorials/NetworkLib/ConfigureASocket#Choose-transport-and-security":{"kind":"section","identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ConfigureASocket#Choose-transport-and-security","type":"section","abstract":[{"text":"Learn how a configuration describes a connection before any network activity begins. Start with a local checkout of NetworkLib, a Swift 6 toolchain, and the existing Examples target on macOS. See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/NetworkLib\/documentation\/NetworkLib\/RunningExamples","type":"reference"},{"text":" for build requirements.","type":"text"}],"title":"Choose transport and security","role":"pseudoSymbol","url":"\/tutorials\/networklib\/configureasocket#Choose-transport-and-security"},"doc://NetworkLib/tutorials/NetworkLib/BridgeCallbacks#Sequence-callback-operations":{"kind":"section","identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/BridgeCallbacks#Sequence-callback-operations","type":"section","abstract":[{"text":"Use the callback API while keeping an asynchronous CLI alive until the work finishes. Complete ","type":"text"},{"isActive":true,"identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ManageSocketLifetime","type":"reference"},{"text":" first. This lesson uses a local plaintext TCP listener.","type":"text"}],"title":"Sequence callback operations","role":"pseudoSymbol","url":"\/tutorials\/networklib\/bridgecallbacks#Sequence-callback-operations"},"doc://NetworkLib/tutorials/NetworkLib/ManageSocketLifetime#Own-the-task-and-the-socket-lifetime":{"kind":"section","identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ManageSocketLifetime#Own-the-task-and-the-socket-lifetime","type":"section","abstract":[{"text":"Add cancellation and error reporting around the transfer from ","type":"text"},{"isActive":true,"identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/TransferBytes","type":"reference"},{"text":". Reuse the existing Examples target and its SendingAndReceivingExample implementation.","type":"text"}],"title":"Own the task and the socket lifetime","role":"pseudoSymbol","url":"\/tutorials\/networklib\/managesocketlifetime#Own-the-task-and-the-socket-lifetime"},"Transfer-01.swift":{"fileName":"SendingAndReceivingExample.swift","highlights":[],"identifier":"Transfer-01.swift","syntax":"swift","fileType":"swift","content":["import NetworkLib","","enum SendingAndReceivingExample {","    static func run() async throws {","        let configuration = RawSocketConfiguration(\"example.com\", .https, sni: \"example.com\", timeout: 15)","        let socket = try RawSocket(configuration)","        do {","            let info = try await socket.connect()","            print(\"Connected to\", info.remoteEndpoint)","            await socket.cancel()","        } catch {","            await socket.cancel()","            throw error","        }","    }","}"],"type":"file"},"doc://NetworkLib/tutorials/NetworkLib/ExchangeTypedMessages#Encode-decode-and-validate-datagrams":{"kind":"section","identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ExchangeTypedMessages#Encode-decode-and-validate-datagrams","type":"section","abstract":[{"text":"Move from raw bytes to a type that supplies outgoing content and validates incoming messages. Complete ","type":"text"},{"isActive":true,"identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/BridgeCallbacks","type":"reference"},{"text":" first. UDP supplies message boundaries for this example.","type":"text"}],"title":"Encode, decode, and validate datagrams","role":"pseudoSymbol","url":"\/tutorials\/networklib\/exchangetypedmessages#Encode-decode-and-validate-datagrams"},"doc://NetworkLib/tutorials/NetworkLib/ExchangeTypedMessages#Check-Your-Understanding":{"titleInlineContent":[{"text":"Check Your Understanding","type":"text"}],"url":"\/tutorials\/networklib\/exchangetypedmessages#Check-Your-Understanding","title":"Check Your Understanding","type":"link","identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ExchangeTypedMessages#Check-Your-Understanding"},"doc://NetworkLib/tutorials/NetworkLib/ManageSocketLifetime#Check-Your-Understanding":{"titleInlineContent":[{"text":"Check Your Understanding","type":"text"}],"url":"\/tutorials\/networklib\/managesocketlifetime#Check-Your-Understanding","title":"Check Your Understanding","type":"link","identifier":"doc:\/\/Networ