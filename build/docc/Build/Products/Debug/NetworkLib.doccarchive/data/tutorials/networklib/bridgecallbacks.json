workLib\/tutorials\/NetworkLib\/ConnectThroughProxy#Check-Your-Understanding"}],"reference":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ConnectThroughProxy"}],"reference":"doc:\/\/NetworkLib\/tutorials\/NetworkLibTutorials\/Advanced-Usage"}],"paths":[["doc:\/\/NetworkLib\/tutorials\/NetworkLibTutorials","doc:\/\/NetworkLib\/tutorials\/NetworkLibTutorials\/$volume","doc:\/\/NetworkLib\/tutorials\/NetworkLibTutorials\/Advanced-Usage"]],"reference":"doc:\/\/NetworkLib\/tutorials\/NetworkLibTutorials"},"kind":"project","metadata":{"title":"Work with Completion Handlers","category":"NetworkLib","categoryPathComponent":"NetworkLibTutorials","role":"project"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/BridgeCallbacks"},"sections":[{"title":"Work with Completion Handlers","chapter":"Advanced Usage","estimatedTimeInMinutes":15,"content":[{"inlineContent":[{"text":"Use the callback API while keeping an asynchronous CLI alive until the work finishes. Complete ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ManageSocketLifetime"},{"text":" first. This lesson uses a local plaintext TCP listener.","type":"text"}],"type":"paragraph"}],"kind":"hero"},{"kind":"tasks","tasks":[{"contentSection":[{"kind":"fullWidth","content":[{"inlineContent":[{"type":"text","text":"Follow the steps in order, then check your understanding below."}],"type":"paragraph"}]}],"title":"Sequence callback operations","stepsSection":[{"runtimePreview":null,"caption":[],"media":null,"type":"step","content":[{"inlineContent":[{"type":"text","text":"In a separate terminal, start "},{"type":"codeVoice","code":"nc -l 9000"},{"type":"text","text":". It listens for the connection and displays received bytes. Restart the listener before each run if it exits."}],"type":"paragraph"}],"code":null},{"caption":[],"content":[{"inlineContent":[{"type":"text","text":"In "},{"type":"codeVoice","code":"Sources\/Examples\/CallbackExample.swift"},{"type":"text","text":", inspect the connect-only snapshot. A checked continuation suspends the CLI without blocking its executor. Resume it exactly once, after socket cancellation has completed."}],"type":"paragraph"}],"media":null,"code":"Callbacks-01.swift","runtimePreview":null,"type":"step"},{"caption":[],"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the complete snapshot to send only after a successful connection. Both failure and send-completion paths close the socket before resuming. Keep Result typed with NWError to preserve the callback’s error information."}]}],"media":null,"code":"Callbacks-02.swift","runtimePreview":null,"type":"step"},{"caption":[],"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Run "},{"type":"codeVoice","code":"swift run Examples callbacks"},{"type":"text","text":". The listener should display "},{"type":"codeVoice","code":"hello from NetworkLib callbacks"},{"type":"text","text":"; the CLI should report send completion and cleanup. Callbacks are @Sendable and use the socket’s callback queue. Protect shared mutable state and explicitly hop to the appropriate actor for UI work. Continue with "},{"identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ExchangeTypedMessages","isActive":true,"type":"reference"},{"type":"text","text":"."}]}],"media":null,"code":null,"runtimePreview":null,"type":"step"}],"anchor":"Sequence-callback-operations"}]},{"anchor":"Check-Your-Understanding","assessments":[{"choices":[{"justification":[{"inlineContent":[{"type":"text","text":"Application-level confirmation requires a reply defined by your protocol."}],"type":"paragraph"}],"isCorrect":true,"content":[{"type":"paragraph","inlineContent":[{"text":"The connection processed the outgoing bytes.","type":"text"}]}]},{"justification":[{"inlineContent":[{"type":"text","text":"Application-level confirmation requires a reply defined by your protocol."}],"type":"paragraph"}],"isCorrect":false,"content":[{"inlineContent":[{"type":"text","text":"The server finished handling the application message."}],"type":"paragraph"}]}],"content":[],"type":"multiple-choice","title":[{"inlineContent":[{"type":"text","text":"What does successful send completion establish?"}],"type":"paragraph"}]}],"kind":"assessments"},{"title":"Design Typed UDP Messages","abstract":[{"text":"Move from raw bytes to a type that supplies outgoing content and validates incoming messages. Complete ","type":"text"},{"isActive":true,"identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/BridgeCallbacks","type":"reference"},{"text":" first. UDP supplies message boundaries for this example.","type":"text"}],"action":{"overridingTitleInlineContent":[{"text":"Get started","type":"text"}],"isActive":true,"overridingTitle":"Get started","identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ExchangeTypedMessages","type":"reference"},"featuredEyebrow":"Tutorial","kind":"callToAction"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"paths":["\/tutorials\/networklib\/bridgecallbacks"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://NetworkLib/tutorials/NetworkLib/ExchangeTypedMessages#Encode-decode-and-validate-datagrams":{"kind":"section","identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ExchangeTypedMessages#Encode-decode-and-validate-datagrams","type":"section","abstract":[{"text":"Move from raw bytes to a type that supplies outgoing content and validates incoming messages. Complete ","type":"text"},{"isActive":true,"identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/BridgeCallbacks","type":"reference"},{"text":" first. UDP supplies message boundaries for this example.","type":"text"}],"title":"Encode, decode, and validate datagrams","role":"pseudoSymbol","url":"\/tutorials\/networklib\/exchangetypedmessages#Encode-decode-and-validate-datagrams"},"doc://NetworkLib/tutorials/NetworkLib/ConfigureASocket#Choose-transport-and-security":{"kind":"section","identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ConfigureASocket#Choose-transport-and-security","type":"section","abstract":[{"text":"Learn how a configuration describes a connection before any network activity begins. Start with a local checkout of NetworkLib, a Swift 6 toolchain, and the existing Examples target on macOS. See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/NetworkLib\/documentation\/NetworkLib\/RunningExamples","type":"reference"},{"text":" for build requirements.","type":"text"}],"title":"Choose transport and security","role":"pseudoSymbol","url":"\/tutorials\/networklib\/configureasocket#Choose-transport-and-security"},"doc://NetworkLib/documentation/NetworkLib/RunningExamples":{"role":"article","identifier":"doc:\/\/NetworkLib\/documentation\/NetworkLib\/RunningExamples","type":"topic","kind":"article","url":"\/documentation\/networklib\/runningexamples","abstract":[{"type":"text","text":"Run the documented API examples from the terminal using the repository’s Examples target."}],"title":"Running the Examples"},"doc://NetworkLib/tutorials/NetworkLib/BridgeCallbacks#Sequence-callback-operations":{"kind":"section","identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/BridgeCallbacks#Sequence-callback-operations","type":"section","abstract":[{"text":"Use the callback API while keeping an asynchronous CLI alive until the work finishes. Complete ","type":"text"},{"isActive":true,"identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ManageSocketLifetime","type":"reference"},{"text":" first. This lesson uses a local plaintext TCP listener.","type":"text"}],"title":"Sequence callback operations","role":"pseudoSymbol","url":"\/tutorials\/networklib\/bridgecallbacks#Sequence-callback-operations"},"Callbacks-02.swift":{"type":"file","identifier":"Callbacks-02.swift","content":["import Foundation","import Network","import NetworkLib","","enum CallbackExample {","    static func run() async throws {","        ExampleCLI.log(\"First run 'nc -l 9000' in another terminal. It will display the payload.\")","        let configuration = RawSocketConfiguration(\"127.0.0.1\", 9000, isSecure: false, timeout: 5)","        let socket = try RawSocket(configuration)","        \/\/ Keep the CLI alive until the callback chain and socket cleanup have finished.","        let result: Result<Void, NWError> = await withCheckedContinuation { continuation in","            ExampleCLI.log(\"Connecting to plaintext TCP at 127.0.0.1:9000…\")","            socket.connect { result in","                switch result {","                case .success(let info):","                    ExampleCLI.log(\"Connected to \\(info.remoteEndpoint); sending hello.\")","                    socket.send(Data(\"hello from NetworkLib callbacks\\n\".utf8)) { sendResult in","                        socket.cancel {","                            continuation.resume(returning: sendResult)","                        }","                    }","                case .failure(let error):","                    socket.cancel {","                        continuation.resume(returning: .failure(error))","                    }","                }","            }","        }","        try result.get()","        ExampleCLI.log(\"Send processed and socket closed. Check the listener terminal for the payload.\")","    }","}"],"highlights":[{"line":1},{"line":7},{"line":10},{"line":11},{"line":12},{"line":14},{"line":15},{"line":16},{"line":17},{"line":18},{"line":19},{"line":20},{"line":21},{"line":22},{"line":23},{"line":24},{"line":25},{"line":29},{"line":30}],"fileName":"CallbackExample.swift","fileType":"swift","syntax":"swift"},"doc://NetworkLib/tutorials/NetworkLib/TransferBytes#Check-Your-Understanding":{"title":"Check Your Understanding","url":"\/tutorials\/networklib\/transferbytes#Check-Your-Understanding","type":"link","identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/TransferBytes#Check-Your-Understanding","titleInlineContent":[{"text":"Check Your Understanding","type":"text"}]},"doc://NetworkLib/tutorials/NetworkLibTutorials/Foundations":{"kind":"article","identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLibTutorials\/Foundations","type":"topic","abstract":[],"title":"Foundations","role":"article","url":"\/tutorials\/networklibtutorials\/foundations"},"doc://NetworkLib/tutorials/NetworkLib/TransferBytes":{"kind":"project","identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/TransferBytes","type":"topic","abstract":[{"text":"Turn a configuration into a TLS connection, send an HTTP\/1.1 request, and collect the response. Complete ","type":"text"},{"isActive":true,"identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ConfigureASocket","type":"reference"},{"text":" first. This lesson requires Internet access.","type":"text"}],"estimatedTime":"15min","title":"Send and Receive over TLS","role":"project","url":"\/tutorials\/networklib\/transferbytes"},"doc://NetworkLib/tutorials/NetworkLib/TransferBytes#Build-an-asynchronous-request":{"kind":"section","identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/TransferBytes#Build-an-asynchronous-request","type":"section","abstract":[{"text":"Turn a configuration into a TLS connection, send an HTTP\/1.1 request, and collect the response. Complete ","type":"text"},{"isActive":true,"identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ConfigureASocket","type":"reference"},{"text":" first. This lesson requires Internet access.","type":"text"}],"title":"Build an asynchronous request","role":"pseudoSymbol","url":"\/tutorials\/networklib\/transferbytes#Build-an-asynchronous-request"},"doc://NetworkLib/tutorials/NetworkLibTutorials":{"identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLibTutorials","kind":"overview","title":"Build Your NetworkLib Skills","role":"overview","type":"topic","url":"\/tutorials\/networklibtutorials","abstract":[{"type":"text","text":"Learn to configure connections, exchange bytes, manage cancellation, and use typed messages and proxies. Work through six guided lessons using the existing Examples target in a local checkout. You need Swift 6 on macOS and basic familiarity with Swift functions, errors, and async\/await. See "},{"isActive":true,"identifier":"doc:\/\/NetworkLib\/documentation\/NetworkLib\/RunningExamples","type":"reference"},{"text":" for build requirements. Code snapshots belong to individual steps; don’t add all snapshots to a target together.","type":"text"}]},"doc://NetworkLib/tutorials/NetworkLib/ManageSocketLifetime":{"kind":"project","identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ManageSocketLifetime","type":"topic","abstract":[{"text":"Add cancellation and error reporting around the transfer from ","type":"text"},{"isActive":true,"identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/TransferBytes","type":"reference"},{"text":". Reuse the existing Examples target and its SendingAndReceivingExample implementation.","type":"text"}],"estimatedTime":"15min","title":"Handle Errors and Cancellation","role":"project","url":"\/tutorials\/networklib\/managesocketlifetime"},"doc://NetworkLib/tutorials/NetworkLib/ManageSocketLifetime#Check-Your-Understanding":{"titleInlineContent":[{"type":"text","text":"Check Your Understanding"}],"type":"link","title":"Check Your Understanding","identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ManageSocketLifetime#Check-Your-Understanding","url":"\/tutorials\/networklib\/managesocketlifetime#Check-Your-Understanding"},"doc://NetworkLib/tutorials/NetworkLib/ExchangeTypedMessages":{"kind":"project","identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ExchangeTypedMessages","type":"topic","abstract":[{"text":"Move from raw bytes to a type that supplies outgoing content and validates incoming messages. Complete ","type":"text"},{"isActive":true,"identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/BridgeCallbacks","type":"reference"},{"text":" first. UDP supplies message boundaries for this example.","type":"text"}],"estimatedTime":"20min","title":"Design Typed UDP Messages","role":"project","url":"\/tutorials\/networklib\/exchangetypedmessages"},"doc://NetworkLib/tutorials/NetworkLib/ConfigureASocket#Check-Your-Understanding":{"url":"\/tutorials\/networklib\/configureasocket#Check-Your-Understanding","title":"Check Your Understanding","titleInlineContent":[{"text":"Check Your Understanding","type":"text"}],"identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ConfigureASocket#Check-Your-Understanding","type":"link"},"doc://NetworkLib/tutorials/NetworkLib/ConnectThroughProxy#Check-Your-Understanding":{"url":"\/tutorials\/networklib\/connectthroughproxy#Check-Your-Understanding","title":"Check Your Understanding","titleInlineContent":[{"text":"Check Your Understanding","type":"text"}],"identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ConnectThroughProxy#Check-Your-Understanding","type":"link"},"doc://NetworkLib/tutorials/NetworkLib/ConnectThroughProxy#Separate-proxy-and-destination-settings":{"kind":"section","identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ConnectThroughProxy#Separate-proxy-and-destination-settings","type":"section","abstract":[{"text":"Combine configuration, TLS, validation, and the existing asynchronous transfer to connect through an HTTP CONNECT proxy. Complete ","type":"text"},{"isActive":true,"identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ExchangeTypedMessages","type":"reference"},{"text":" first. You must supply a running proxy; the CLI does not create one. Requires macOS 12.3 or later.","type":"text"}],"title":"Separate proxy and destination settings","role":"pseudoSymbol","url":"\/tutorials\/networklib\/connectthroughproxy#Separate-proxy-and-destination-settings"},"doc://NetworkLib/tutorials/NetworkLib/ManageSocketLifetime#Own-the-task-and-the-socket-lifetime":{"kind":"section","identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ManageSocketLifetime#Own-the-task-and-the-socket-lifetime","type":"section","abstract":[{"text":"Add cancellation and error reporting around the transfer from ","type":"text"},{"isActive":true,"identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/TransferBytes","type":"reference"},{"text":". Reuse the existing Examples target and its SendingAndReceivingExample implementation.","type":"text"}],"title":"Own the task and the socket lifetime","role":"pseudoSymbol","url":"\/tutorials\/networklib\/managesocketlifetime#Own-the-task-and-the-socket-lifetime"},"Callbacks-01.swift":{"type":"file","content":["import Network","import NetworkLib","","enum CallbackExample {","    static func run() async throws {","        let configuration = RawSocketConfiguration(\"127.0.0.1\", 9000, isSecure: false, timeout: 5)","        let socket = try RawSocket(configuration)","        let result: Result<ConnectionInfo, NWError> = await withCheckedContinuation { continuation in","            socket.connect { result in","                socket.cancel {","                    continuation.resume(returning: result)","                }","            }","        }","        let info = try result.get()","        print(\"Connected and closed:\", info.remoteEndpoint)","    }","}"],"identifier":"Callbacks-01.swift","highlights":[],"fileName":"CallbackExample.swift","fileType":"swift","syntax":"swift"},"doc://NetworkLib/tutorials/NetworkLib/BridgeCallbacks#Check-Your-Understanding":{"type":"link","identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/BridgeCallbacks#Check-Your-Understanding","title":"Check Your Understanding","url":"\/tutorials\/networklib\/bridgecallbacks#Check-Your-Understanding","titleInlineContent":[{"type":"text","text":"Check Your Understanding"}]},"doc://NetworkLib/tutorials/NetworkLib/ConfigureASocket":{"kind":"project","identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ConfigureASocket","type":"topic","abstract":[{"text":"Learn how a configuration describes a connection before any network activity begins. Start with a local checkout of NetworkLib, a Swift 6 toolchain, and the existing Examples target on macOS. See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/NetworkLib\/documentation\/NetworkLib\/RunningExamples","type":"reference"},{"text":" for build requirements.","type":"text"}],"estimatedTime":"10min","title":"Configure Your First Socket","role":"project","url":"\/tutorials\/networklib\/configureasocket"},"doc://NetworkLib/tutorials/NetworkLibTutorials/Advanced-Usage":{"kind":"article","identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLibTutorials\/Advanced-Usage","type":"topic","abstract":[],"title":"Advanced Usage","role":"article","url":"\/tutorials\/networklibtutorials\/advanced-usage"},"doc://NetworkLib/tutorials/NetworkLib/ConnectThroughProxy":{"kind":"project","identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ConnectThroughProxy","type":"topic","abstract":[{"text":"Combine configuration, TLS, validation, and the existing asynchronous transfer to connect through an HTTP CONNECT proxy. Complete ","type":"text"},{"isActive":true,"identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ExchangeTypedMessages","type":"reference"},{"text":" first. You must supply a running proxy; the CLI does not create one. Requires macOS 12.3 or later.","type":"text"}],"estimatedTime":"20min","title":"Configure Authenticated Proxy Connections","role":"project","url":"\/tutorials\/networklib\/connectthroughproxy"},"doc://NetworkLib/tutorials/NetworkLib/ExchangeTypedMessages#Check-Your-Understanding":{"url":"\/tutorials\/networklib\/exchangetypedmessages#Check-Your-Understanding","title":"Check Your Understanding","titleInlineContent":[{"text":"Check Your Understanding","type":"text"}],"identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ExchangeTypedMessages#Check-Your-Understanding","type":"link"},"doc://NetworkLib/tutorials/NetworkLib/BridgeCallbacks":{"kind":"project","identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/BridgeCallbacks","type":"topic","abstract":[{"text":"Use the callback API while keeping an asynchronous CLI alive until the work finishes. Complete ","type":"text"},{"isActive":true,"identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ManageSocketLifetime","type":"reference"},{"text":" first. This lesson uses a local plaintext TCP listener.","type":"text"}],"estimatedTime":"15min","title":"Work with Completion Handlers","role":"project","url":"\/tutorials\/networklib\/bridgecallbacks"}}}