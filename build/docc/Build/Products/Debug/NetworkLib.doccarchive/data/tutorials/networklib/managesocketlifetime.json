ntent":[{"inlineContent":[{"text":"Replace the wrapper with this version. Keep the task handle, optionally cancel it, and await its result. Cancelling a task performing an asynchronous socket operation permanently cancels that socket. The API reports NWError; don’t assume it throws CancellationError.","type":"text"}],"type":"paragraph"}],"runtimePreview":null,"caption":[]},{"type":"step","media":null,"code":null,"content":[{"inlineContent":[{"text":"To exercise the wrapper, temporarily replace the existing ","type":"text"},{"type":"codeVoice","code":"async"},{"text":" case in ","type":"text"},{"type":"codeVoice","code":"main.swift"},{"text":" with ","type":"text"},{"type":"codeVoice","code":"case \"async\": await runTransfer(cancelImmediately: true)"},{"text":", then run ","type":"text"},{"type":"codeVoice","code":"swift run Examples async"},{"text":". Expect cancellation or another reported network error, rather than an unhandled failure. This wrapper intentionally catches errors for inspection, so the CLI may still print its normal completion message.","type":"text"}],"type":"paragraph"}],"runtimePreview":null,"caption":[]},{"type":"step","media":null,"code":null,"content":[{"inlineContent":[{"text":"Repeat with ","type":"text"},{"type":"codeVoice","code":"cancelImmediately: false"},{"text":" to allow the transfer to finish. Restore the original ","type":"text"},{"type":"codeVoice","code":"async"},{"text":" case afterward. A retry must create a new socket; never reconnect a cancelled instance. Inactivity timeouts aren’t total deadlines: continuous traffic can keep an operation active. Continue with ","type":"text"},{"identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/BridgeCallbacks","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"paragraph"}],"runtimePreview":null,"caption":[]}]}]},{"assessments":[{"type":"multiple-choice","title":[{"type":"paragraph","inlineContent":[{"text":"How should you retry after cancelling a socket?","type":"text"}]}],"content":[],"choices":[{"content":[{"inlineContent":[{"text":"Create a new socket for a new connection attempt.","type":"text"}],"type":"paragraph"}],"justification":[{"inlineContent":[{"text":"A RawSocket represents one connection attempt and cannot be reused after cancellation or closure.","type":"text"}],"type":"paragraph"}],"isCorrect":true},{"content":[{"inlineContent":[{"text":"Call connect again on the cancelled socket.","type":"text"}],"type":"paragraph"}],"justification":[{"inlineContent":[{"text":"A RawSocket represents one connection attempt and cannot be reused after cancellation or closure.","type":"text"}],"type":"paragraph"}],"isCorrect":false}]}],"kind":"assessments","anchor":"Check-Your-Understanding"},{"abstract":[{"type":"text","text":"Use the callback API while keeping an asynchronous CLI alive until the work finishes. Complete "},{"isActive":true,"type":"reference","identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ManageSocketLifetime"},{"type":"text","text":" first. This lesson uses a local plaintext TCP listener."}],"action":{"isActive":true,"type":"reference","identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/BridgeCallbacks","overridingTitle":"Get started","overridingTitleInlineContent":[{"type":"text","text":"Get started"}]},"kind":"callToAction","featuredEyebrow":"Tutorial","title":"Work with Completion Handlers"}],"metadata":{"category":"NetworkLib","role":"project","categoryPathComponent":"NetworkLibTutorials","title":"Handle Errors and Cancellation"},"variants":[{"paths":["\/tutorials\/networklib\/managesocketlifetime"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://NetworkLib/tutorials/NetworkLib/ConfigureASocket#Choose-transport-and-security":{"kind":"section","identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ConfigureASocket#Choose-transport-and-security","type":"section","abstract":[{"text":"Learn how a configuration describes a connection