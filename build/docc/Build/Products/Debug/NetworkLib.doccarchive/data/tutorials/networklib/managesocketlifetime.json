ages#Check-Your-Understanding":{"titleInlineContent":[{"type":"text","text":"Check Your Understanding"}],"url":"\/tutorials\/networklib\/exchangetypedmessages#Check-Your-Understanding","identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ExchangeTypedMessages#Check-Your-Understanding","type":"link","title":"Check Your Understanding"},"Lifecycle-02.swift":{"syntax":"swift","identifier":"Lifecycle-02.swift","highlights":[{"line":4},{"line":5},{"line":7},{"line":8},{"line":9},{"line":10},{"line":11},{"line":12}],"fileType":"swift","content":["import Network","import NetworkLib","","func runTransfer(cancelImmediately: Bool) async {","    let task = Task {","        try await SendingAndReceivingExample.run()","    }","    if cancelImmediately {","        task.cancel()","    }","    do {","        try await task.value","    } catch let error as NWError {","        switch error {","        case .posix(.ETIMEDOUT):","            print(\"The connection timed out. Check the destination and network.\")","        case .posix(.ECANCELED):","            print(\"The socket was cancelled.\")","        default:","            print(\"Network operation failed:\", error)","        }","    } catch {","        print(\"Transfer failed:\", error)","    }","}"],"type":"file","fileName":"TransferLifecycle.swift"},"doc://NetworkLib/tutorials/NetworkLib/BridgeCallbacks":{"kind":"project","identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/BridgeCallbacks","type":"topic","abstract":[{"text":"Use the callback API while keeping an asynchronous CLI alive until the work finishes. Complete ","type":"text"},{"isActive":true,"identifier":"doc:\/\/NetworkLib\/tutorials\/NetworkLib\/ManageSocketLifetime","type":"reference"},{"text":" first. This lesson uses a local plaintext TCP listener.","type":"text"}],"estimatedTime":"15min","title":"Work with Completion Handlers","role":"project","url":"\/tutorials\/networklib\/bridgecallbacks"}}}